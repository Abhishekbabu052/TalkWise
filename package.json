{
  "name": "talkwise",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "start": "npm run dev",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client -- --open",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "seed:admin": "node server/config/seedAdmin.js"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.3",
    "multer": "^2.4.0",
    "socket.io": "^4.8.4"
  }
}
